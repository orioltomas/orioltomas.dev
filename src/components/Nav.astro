---
import ThemeToggle from './ThemeToggle.astro';
import { copy } from '../data/copy';
import { altLocale, type Locale } from '../data/site';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = copy[locale];
const other = altLocale[locale];
---

<nav class="nav no-print" aria-label={t.nav.work}>
  <div class="nav__inner shell">
    <a class="nav__mark" href={locale === 'en' ? '/en/' : '/'}>
      Oriol Tomàs<span>.</span>
    </a>

    <ul class="nav__menu">
      <li><a href="#work">{t.nav.work}</a></li>
      <li><a href="#stack">{t.nav.stack}</a></li>
      <li><a href="#education">{t.nav.education}</a></li>
      <li><a href="#contact">{t.nav.contact}</a></li>
    </ul>

    <div class="nav__tools">
      <a class="nav__lang" href={other.path} hreflang={other.locale} title={t.ui.lang}>
        {other.label}
      </a>
      <ThemeToggle locale={locale} />
    </div>
  </div>
</nav>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 5;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--rule);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    gap: 20px;
    padding-block: 12px;
  }

  .nav__mark {
    font-family: var(--serif);
    font-size: 19px;
    letter-spacing: -0.015em;
    text-decoration: none;
    white-space: nowrap;
  }

  .nav__mark span {
    color: var(--accent);
  }

  .nav__menu {
    display: none;
    gap: 24px;
    list-style: none;
    margin: 0 auto;
    padding: 0;
    font-family: var(--mono);
    font-size: 11.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .nav__menu a {
    color: var(--mid);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .nav__menu a:hover {
    color: var(--ink);
  }

  .nav__tools {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-left: auto;
  }

  .nav__lang {
    font-family: var(--mono);
    font-size: 11.5px;
    letter-spacing: 0.1em;
    color: var(--mid);
    text-decoration: none;
    border: 1px solid var(--rule);
    border-radius: 999px;
    padding: 5px 11px;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .nav__lang:hover {
    color: var(--ink);
    border-color: var(--mid);
  }

  @media (min-width: 720px) {
    .nav__menu {
      display: flex;
    }
    .nav__tools {
      margin-left: 0;
    }
  }
</style>
