---
import { copy } from '../data/copy';
import { jobs, formatRange } from '../data/cv';
import type { Locale } from '../data/site';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = copy[locale];
---

<section class="section" id="work">
  <h2 class="section__title">{t.sections.work}</h2>

  {
    jobs.map((job) => {
      const text = t.jobs[job.id];
      return (
        <article class="job">
          <p class="job__years">{job.years}</p>

          <div class="job__body">
            <h3 class="job__company">{job.company}</h3>
            <p class="job__meta">{text.meta}</p>

            <ul class="job__roles">
              {job.roles.map((role) => (
                <li>
                  <b>{text.roles[role.id]}</b>
                  <time>{formatRange(role, locale, t.present)}</time>
                  {role.to === null && <span class="job__now">{t.current}</span>}
                </li>
              ))}
            </ul>

            <p class="job__blurb">{text.blurb}</p>

            <ul class="job__tags">
              {job.tags.map((tag) => (
                <li>{tag}</li>
              ))}
            </ul>
          </div>
        </article>
      );
    })
  }
</section>

<style>
  .job {
    display: grid;
    grid-template-columns: 1fr;
    gap: 6px 26px;
    padding-block: 22px;
    border-top: 1px solid var(--rule);
  }

  .job__years {
    margin: 0;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--mid);
    font-variant-numeric: tabular-nums;
  }

  .job__company {
    margin: 0;
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(23px, 3.4vw, 28px);
    line-height: 1.15;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .job__meta {
    margin: 4px 0 0;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--mid);
  }

  .job__roles {
    list-style: none;
    margin: 15px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .job__roles li {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 6px 14px;
  }

  .job__roles b {
    font-weight: 600;
    font-size: 14.5px;
  }

  .job__roles time {
    font-family: var(--mono);
    font-size: 11.5px;
    color: var(--mid);
    font-variant-numeric: tabular-nums;
  }

  .job__now {
    font-family: var(--mono);
    font-size: 9.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    background: var(--accent);
    color: var(--accent-ink);
    padding: 2px 7px;
    border-radius: 2px;
  }

  .job__blurb {
    margin: 12px 0 0;
    max-width: var(--measure);
    font-size: 14.5px;
    color: var(--mid);
  }

  .job__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    list-style: none;
    margin: 13px 0 0;
    padding: 0;
  }

  .job__tags li {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--mid);
    border: 1px solid var(--rule);
    border-radius: 2px;
    padding: 2px 8px;
  }

  @media (min-width: 640px) {
    .job {
      grid-template-columns: var(--gutter) 1fr;
    }
    .job__years {
      padding-top: 6px;
    }
  }
</style>
