{
  // This project is a Worker serving static assets, not a Pages project.
  // `name` must match the existing Worker exactly, or a push would deploy a
  // second, separate Worker instead of updating this one.
  "name": "orioltomas-dev",
  "compatibility_date": "2026-09-08",
  "assets": {
    "directory": "./dist/",
    // Without this, an unmatched route returns an empty 404 body instead of
    // the site's own 404 page.
    "not_found_handling": "404-page"
  }
}
